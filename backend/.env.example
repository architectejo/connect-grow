# Copier ce fichier en .env et renseigner les valeurs. Ne jamais committer .env (2.5, 4.2).

# --- Django ---
# Obligatoire hors DEBUG : le serveur refuse de démarrer sans clé secrète unique.
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Base de données (2.5) ---
# SQLite seul jusqu'à la fin du projet (ADR 0001).
DB_ENGINE=sqlite
# Relatif au dossier backend ; en Docker, compose le place sur un volume (data/).
DB_NAME=db.sqlite3

# --- CORS (frontend React) ---
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# --- Derrière Nginx (production) ---
# BEHIND_PROXY=True fait confiance à X-Forwarded-Proto (Nginx : proxy_set_header X-Forwarded-Proto $scheme;).
BEHIND_PROXY=False

# --- Limitation de débit ---
# Nombre de proxies de confiance devant l'application : 0 en direct (développement), 1 derrière
# Nginx. Une valeur fausse fausse l'IP vue par les throttles (0 derrière un proxy : tous les
# clients partagent l'IP du proxy ; trop haut : l'en-tête X-Forwarded-For devient falsifiable).
NUM_PROXIES=0

# --- Outbox des événements de domaine (ADR 0003) ---
# Diffusion immédiate après validation (le cron dispatch_outbox reste le filet de sécurité).
OUTBOX_INLINE_DISPATCH=True
# Conservation des événements traités / en échec définitif, en jours.
OUTBOX_RETENTION_DAYS=7
OUTBOX_DEAD_RETENTION_DAYS=30

# --- Pagination de l API (taille par defaut et plafond de page_size) ---
API_PAGE_SIZE=20
API_MAX_PAGE_SIZE=100
